# IRIS Protocol — environment template
# Copy to .env and fill in. Every variable the stack reads is listed here
# (v2 section 24: "document every env var").
#
# `docker compose up` works with this file copied verbatim — every secret below
# is optional, and the affected subsystem degrades to a labelled SIMULATION
# path rather than failing to boot.

# ── Core ─────────────────────────────────────────────────────────────────────
# Overridden by docker-compose for the api container.
DATABASE_URL=postgresql://iris:iris@localhost:5432/iris
REDIS_URL=redis://localhost:6379

# ── Web (browser-visible; never put a secret behind NEXT_PUBLIC_) ────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Without this the wallet button renders a disabled "unavailable" state.
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Solana — the sole canonical chain (v2 section 2) ─────────────────────────
# devnet, matching the deployed programs below
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_ADDRESS=
# Live on devnet. `make devnet-deploy` writes these; they are the ids
# `declare_id!` and Anchor.toml are synced to.
SOLANA_AGENT_REGISTRY=6NTKNCtBnNAJjGfgFRNTPhbxBYz1GXv3mQRRdwdC2cNy
SOLANA_ALLOCATION_ENGINE=
SOLANA_CAPITAL_VAULT=HYxAvbCGmv7axJfQbbSxQXLyNiAhPQUyAsEo6nVUW1Gj
SOLANA_SLASHING_MODULE=

# ── Market data ──────────────────────────────────────────────────────────────
# "simulated" runs the Ornstein-Uhlenbeck price engine. Anything else must be
# backed by a real feed before the UI may drop its SIMULATION label.
WS_MARKET_SOURCE=simulated
WS_NORMALIZED_STREAM_ENABLED=true
ALPHA_VANTAGE_API_KEY=

# ── News and social ──────────────────────────────────────────────────────────
APIFY_API_TOKEN=
APIFY_CRYPTOPANIC_ACTOR_ID=
NEWS_API_KEY=
GDELT_API_URL=

# ── Model providers (optional) ───────────────────────────────────────────────
# The four strategy agents are rule/ML-driven and need no key. Only the
# Adaptive Research agent's synthesis step uses an LLM, and it falls back to a
# deterministic combiner when these are unset.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=

# ── Model artifact storage (optional) ────────────────────────────────────────

# ── Algorand (legacy; not in the v2 critical path) ───────────────────────────
ALGORAND_ALGOD_URL=
ALGORAND_INDEXER_URL=
ALGORAND_API_TOKEN=
